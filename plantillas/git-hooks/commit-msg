#!/bin/bash
# commit-msg hook: blocks AI attribution (R3) and enforces commit format (R3).
# Location: scripts/hooks/commit-msg (versioned)
# Enable: git config core.hooksPath scripts/hooks
#
# Receives the message file path as $1.
# Unlike pre-commit, this hook DOES have access to the message (runs after it is written).
set -euo pipefail

MSG_FILE="${1:-}"
[ -f "$MSG_FILE" ] || exit 0

CONFIG_FILE=".claude/project.config.json"
CO_AUTHORED="false"
COMMIT_STYLE="conventional"
if command -v jq >/dev/null 2>&1 && [ -f "$CONFIG_FILE" ]; then
  CO_AUTHORED=$(jq -r '.git.coAuthoredBy // false' "$CONFIG_FILE" 2>/dev/null)
  COMMIT_STYLE=$(jq -r '.conventions.commits // "conventional"' "$CONFIG_FILE" 2>/dev/null)
fi

# --- 1. AI attribution (R3, only when coAuthoredBy is false) ---
# Match ATTRIBUTION patterns only (not a loose "Claude" mention, so legitimate messages
# like "add Claude Code hook" keep working). Only automatic co-authorship trailers.
if [ "$CO_AUTHORED" != "true" ]; then
  PATTERN='Co-Authored-By:|Generated with \[?Claude|🤖 Generated|noreply@anthropic\.com'
  if grep -iEq "$PATTERN" "$MSG_FILE"; then
    echo "" >&2
    echo "ERROR commit-msg: message contains AI attribution / automatic co-authorship (R3)." >&2
    echo "Offending lines:" >&2
    grep -iEn "$PATTERN" "$MSG_FILE" >&2
    echo "" >&2
    echo "Remove those lines and commit again." >&2
    exit 1
  fi
fi

# --- 2. Conventional commit format (conventions.commits) ---
if [ "$COMMIT_STYLE" != "conventional" ]; then
  exit 0
fi

# Subject: first non-empty, non-comment line.
SUBJECT=$(grep -vE '^[[:space:]]*#' "$MSG_FILE" | grep -vE '^[[:space:]]*$' | head -n1 || true)

# Exceptions: merges and reverts autogenerated by git.
if printf '%s' "$SUBJECT" | grep -qE '^(Merge |Revert )'; then
  exit 0
fi

# Expected format: type(optional scope)!?: description
CONV='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$SUBJECT" | grep -qE "$CONV"; then
  echo "" >&2
  echo "ERROR commit-msg: subject does not follow conventional commits." >&2
  echo "  Received: '$SUBJECT'" >&2
  echo "  Format:   type(scope): description" >&2
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi

exit 0
