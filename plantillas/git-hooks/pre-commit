#!/bin/sh
# pre-commit hook: Quality validation before commits
# Checks: lint (if configured), per-type file size (WF-R4), TypeScript errors (WF-R16)
# Bypass: git commit --no-verify (emergencies only)

CONFIG_FILE=".claude/project.config.json"

# Guardrail: never commit directly on the protected branch (WF-R2)
# Skipped when git.allowCommitsOnMain is true (framework/template repos only).
MAIN_BRANCH="main"
ALLOW_ON_MAIN="false"
if command -v jq >/dev/null 2>&1 && [ -f "$CONFIG_FILE" ]; then
  MAIN_BRANCH=$(jq -r '.git.mainBranch // "main"' "$CONFIG_FILE" 2>/dev/null)
  ALLOW_ON_MAIN=$(jq -r '.git.allowCommitsOnMain // false' "$CONFIG_FILE" 2>/dev/null)
fi
# symbolic-ref names the branch even before the first commit (rev-parse answers "HEAD").
CURRENT_BRANCH=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
# The first commit of a repo creates main: nothing can branch from a main that does not exist.
# It is let through on purpose (/setup makes it); from the second one on, main is protected.
if [ "$ALLOW_ON_MAIN" != "true" ] && [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ] && ! git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  echo "pre-commit: initial commit on '$MAIN_BRANCH' allowed (the repo has no history yet). From the next one on, '$MAIN_BRANCH' is protected (WF-R2)."
elif [ "$ALLOW_ON_MAIN" != "true" ] && [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ]; then
  echo "pre-commit: direct commit on '$MAIN_BRANCH' is blocked (WF-R2)." >&2
  echo "  '$MAIN_BRANCH' only receives merges. Switch branch first." >&2
  exit 1
fi

# Default limits
LINT_CMD=""
MAX_DEFAULT=400
MAX_SERVICE=400
MAX_COMPONENT=400
MAX_HOOK=400

# Read config (if jq available)
if command -v jq >/dev/null 2>&1 && [ -f "$CONFIG_FILE" ]; then
  LINT_CMD=$(jq -r '.commands.lint // ""' "$CONFIG_FILE")

  # Per-type limits: check if maxFileLines is object or number
  MAX_TYPE=$(jq -r '.workflow.maxFileLines | type' "$CONFIG_FILE" 2>/dev/null)
  if [ "$MAX_TYPE" = "object" ]; then
    MAX_SERVICE=$(jq -r '.workflow.maxFileLines.services // 500' "$CONFIG_FILE")
    MAX_COMPONENT=$(jq -r '.workflow.maxFileLines.components // 300' "$CONFIG_FILE")
    MAX_HOOK=$(jq -r '.workflow.maxFileLines.hooks // 150' "$CONFIG_FILE")
    MAX_DEFAULT=$(jq -r '.workflow.maxFileLines.default // 400' "$CONFIG_FILE")
  else
    MAX_DEFAULT=$(jq -r '.workflow.maxFileLines // 400' "$CONFIG_FILE")
    MAX_SERVICE=$MAX_DEFAULT
    MAX_COMPONENT=$MAX_DEFAULT
    MAX_HOOK=$MAX_DEFAULT
  fi
fi

# Check 1: Lint (if configured AND actually runnable)
# A missing lint setup must not block commits — only real lint failures do.
if [ -n "$LINT_CMD" ]; then
  echo "pre-commit: Running lint..."
  LINT_OUT=$(eval "$LINT_CMD" 2>&1)
  LINT_CODE=$?
  if [ "$LINT_CODE" -ne 0 ]; then
    # Distinguish "lint is not set up here" from "the code fails lint"
    if [ "$LINT_CODE" -eq 127 ] || \
       echo "$LINT_OUT" | grep -qiE "missing script|command not found|ENOENT|no such file|could not determine executable"; then
      echo "pre-commit: lint command not available here, skipping ('$LINT_CMD')."
    else
      echo "$LINT_OUT"
      echo "pre-commit: Lint failed. Fix issues or use --no-verify to bypass."
      exit 1
    fi
  fi
fi

# Check 2: File size per type (WF-R4)
# Applies to SOURCE CODE only. Documentation, config, data and generated files are exempt:
# a long MANUAL or schema is not technical debt, and capping them just teaches people to
# bypass the hook.
ERRORS=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  if [ -f "$file" ]; then
    # Skip non-code files
    case "$file" in
      *.md|*.mdx|*.txt|*.rst|*.adoc) continue ;;
      *.json|*.jsonc|*.yml|*.yaml|*.toml|*.ini|*.env*) continue ;;
      *.lock|*-lock.json|*.sum) continue ;;
      *.csv|*.tsv|*.sql|*.svg|*.snap) continue ;;
      *.prisma|*.graphql|*.proto) continue ;;
      *.gitignore|*.gitkeep|LICENSE|*.patch|*.diff) continue ;;
      */migrations/*|*/generated/*|*/__generated__/*|*.generated.*) continue ;;
    esac

    lines=$(wc -l < "$file")
    MAX_LIMIT=$MAX_DEFAULT

    # Determine file type and apply specific limit
    case "$file" in
      scripts/hooks/*)
        # Git hooks are shell scripts, not React custom hooks. The 150-line limit
        # below is meant for `useSomething.ts`; this folder only matches `*/hooks/*`
        # by name. Left unhandled, pre-commit blocks itself the moment a hook grows
        # past 150 lines — which is exactly what happened.
        MAX_LIMIT=$MAX_DEFAULT
        ;;
      *.service.ts|*.service.js)
        MAX_LIMIT=$MAX_SERVICE
        ;;
      *.tsx|*.component.ts|*.component.js)
        MAX_LIMIT=$MAX_COMPONENT
        ;;
      */hooks/*|*/use[A-Z]*.ts|*/use[A-Z]*.tsx)
        MAX_LIMIT=$MAX_HOOK
        ;;
    esac

    if [ "$lines" -gt "$MAX_LIMIT" ]; then
      echo "  ERROR: $file has $lines lines (max: $MAX_LIMIT)"
      ERRORS=$((ERRORS + 1))
    fi
  fi
done
if [ "$ERRORS" -gt 0 ]; then
  echo "pre-commit: $ERRORS file(s) exceed line limits (WF-R4). Refactor before committing."
  echo "  Use --no-verify to bypass in emergencies."
  exit 1
fi

# Check 3: No business truth written in two places (R30)
# A rule written in CLAUDE.md lasts until the first session that starts without
# context. This one is verified, not remembered. Does nothing until the project
# declares a "truth" block in .claude/project.config.json.
CHECK_VERDAD="$(dirname "$0")/check-una-sola-verdad.sh"
if [ -x "$CHECK_VERDAD" ]; then
  echo "pre-commit: Checking for business truth written twice..."
  if ! "$CHECK_VERDAD"; then
    echo "pre-commit: A business truth is enumerated outside its home (R30). Fix or declare it before committing."
    exit 1
  fi
fi

# Check 4: TypeScript errors (WF-R16, if tsc available)
if command -v npx >/dev/null 2>&1 && [ -f "tsconfig.json" ]; then
  echo "pre-commit: Checking TypeScript..."
  npx tsc --noEmit 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "pre-commit: TypeScript errors found (WF-R16). Fix before committing."
    exit 1
  fi
fi

echo "pre-commit: All checks passed."
