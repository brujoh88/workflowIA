#!/bin/bash
# wf-plantillas — copia al proyecto las plantillas del plugin wf. Lo usa /wf:setup.
#
# Regla única: NUNCA pisa un archivo que ya existe. Lo que el proyecto tiene es del
# proyecto; si difiere de la plantilla se informa y se deja como está.
#
#   wf-plantillas            copia lo que falta e instala los git hooks
#   wf-plantillas --ver      solo muestra qué haría, sin tocar nada
#
# Dónde va cada cosa:
#   plantillas/git-hooks/*  -> scripts/hooks/  (+ git config core.hooksPath scripts/hooks)
#   plantillas/gitignore    -> .gitignore      (si existe: agrega solo las líneas que faltan)
#   el resto                -> misma ruta relativa en el proyecto
#
# Vive en bin/ del plugin (está en el PATH de Bash mientras el plugin esté activo).

set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ORIGEN="$PLUGIN_ROOT/plantillas"
DESTINO="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
SOLO_VER=false
[ "${1:-}" = "--ver" ] && SOLO_VER=true

[ -d "$ORIGEN" ] || { echo "wf-plantillas: no encuentro $ORIGEN" >&2; exit 1; }

copiados=(); quedaron=(); distintos=()

copiar() {  # copiar <origen> <ruta relativa en el proyecto>
  local de="$1" rel="$2" a="$DESTINO/$2"
  if [ -e "$a" ]; then
    if cmp -s "$de" "$a"; then quedaron+=("$rel"); else distintos+=("$rel"); fi
    return
  fi
  copiados+=("$rel")
  $SOLO_VER && return
  mkdir -p "$(dirname "$a")"
  cp -p "$de" "$a"
}

while IFS= read -r -d '' f; do
  rel="${f#"$ORIGEN"/}"
  case "$rel" in
    git-hooks/*) copiar "$f" "scripts/hooks/${rel#git-hooks/}" ;;
    gitignore)   ;;
    *)           copiar "$f" "$rel" ;;
  esac
done < <(find "$ORIGEN" -type f -print0 | sort -z)

# .gitignore: aditivo, nunca reemplaza
faltan=()
while IFS= read -r linea; do
  [ -z "$linea" ] && continue
  [[ "$linea" == \#* ]] && continue
  grep -qxF -- "$linea" "$DESTINO/.gitignore" 2>/dev/null || faltan+=("$linea")
done < "$ORIGEN/gitignore"
if [ ${#faltan[@]} -gt 0 ] && ! $SOLO_VER; then
  { [ -s "$DESTINO/.gitignore" ] && echo; echo "# workflowIA (wf)"; printf '%s\n' "${faltan[@]}"; } >> "$DESTINO/.gitignore"
fi

# git hooks: ejecutables y enganchados
if ! $SOLO_VER && [ -d "$DESTINO/scripts/hooks" ]; then
  chmod +x "$DESTINO"/scripts/hooks/* 2>/dev/null || true
  git -C "$DESTINO" rev-parse --git-dir >/dev/null 2>&1 && git -C "$DESTINO" config core.hooksPath scripts/hooks
fi

$SOLO_VER && echo "wf-plantillas (--ver: no se tocó nada)"
echo "Copiados: ${#copiados[@]}"
[ ${#copiados[@]} -gt 0 ] && printf '  + %s\n' "${copiados[@]}"
echo "Ya estaban iguales: ${#quedaron[@]}"
echo "Ya existían y difieren, se dejaron como estaban: ${#distintos[@]}"
[ ${#distintos[@]} -gt 0 ] && printf '  = %s\n' "${distintos[@]}"
echo ".gitignore: ${#faltan[@]} línea(s) agregadas"
